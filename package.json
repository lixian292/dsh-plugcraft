{
  "name": "dsh-plugin-workbench",
  "version": "0.9.0",
  "description": "Reuse-first plugin authoring workbench for DeepSeek Harness (DSH): clarify the need, search plugins/repos to reuse, decide, decompose the gaps, then build.",
  "author": "lixian292",
  "homepage": "https://github.com/lixian292/dsh-plugin-workbench",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lixian292/dsh-plugin-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/lixian292/dsh-plugin-workbench/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "workbench",
    "reuse"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2+": "compatible",
        "0.2.2-rc.1+": "compatible"
      }
    }
  }
}

